[user]
  name = Kyle Mathews
  email = mathews.kyle@gmail.com
[color]
  status = auto
  branch = auto
[color "diff"]
  meta = blue
  old = black red strike
  new = black green italic
  context = yellow bold
[push]
  default = simple
  autoSetupRemote = true
[init]
  defaultBranch = main
[alias]
  ai = add --interactive
  unstage = reset HEAD

  c = commit -v
  cm = commit -m
  ca = commit --amend
  caa = commit -a --amend -C HEAD

  s = status
  a = add
  co = checkout
  b = branch
  l = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --date=relative
  lc = log ORIG_HEAD.. --stat --no-merges
  f = fetch
  p = push
  d = diff
  dc = diff --cached --color
  da = diff HEAD
  da2 = diff HEAD^
[core]
  excludesfile = ~/.gitignore_global
  editor = nvim
[merge]
  conflictstyle = diff3
[diff]
  colorMoved = default
[rerere]
  enabled = true
[include]
  path = ~/.gitconfig.local
