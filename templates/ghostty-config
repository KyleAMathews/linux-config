cursor-style = block
cursor-style-blink = true

theme = "tokyonight"

keybind = global:cmd+j=toggle_quick_terminal
keybind = shift+enter=text:\n

clipboard-read = "allow"
clipboard-paste-protection = false
clipboard-trim-trailing-spaces = true

font-family = "InconsolataNFM"
font-size = 14
font-style = "Medium"
font-family-bold = "InconsolataNFM"
font-style-bold = "Bold"
font-family-italic = "InconsolataNFM"
font-style-italic = "Italic"
font-family-bold-italic = "InconsolataNFM"
font-style-bold-italic = "Bold Italic"
font-feature = zero
font-feature = ss01
font-feature = ss02
font-feature = ss03
font-feature = ss04
font-feature = ss05
font-feature = ss06
font-feature = calt
font-feature = liga

background-opacity = 0.95
desktop-notifications = true
